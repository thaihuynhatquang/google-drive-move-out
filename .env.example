# Copy to .env.local for `npm run dev` (see README). On Netlify, set these in Site settings -> Environment variables.
# OAuth client of type "Web application"; redirect URIs: http://localhost:3000/callback and https://<site>.netlify.app/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, comma-separated extra origins allowed to call /api/oauth (e.g. a custom domain)
ALLOWED_ORIGINS=
